---
import createBrandFooter from '../lib/brand-footer-kit.cjs';
import { brand, siblingTools } from '../data/brand';

const footer = createBrandFooter({ brand, tools: siblingTools });

const html = footer.html({
  // 傳本站網址：同 host 的工具會被排除，也當作輪替起點
  currentUrl: Astro.site ? Astro.site.href : undefined,
  limit: 6,
  nav: [
    { label: '測速', href: '/' },
    { label: '測速原理', href: '/learn' },
    { label: '開發者 SDK', href: '/sdk' },
    { label: 'API', href: '/api' },
    { label: '部落格', href: '/blog' },
  ],
  note: '，MST 測速是其中一個。',
  moreBlurb: '桌面 App、自架服務與開發工具',
});
---

<Fragment set:html={html} />

<style is:global set:html={footer.css()}></style>

<style is:global>
  /* 套到本站的配色；kit 的規則不動，只換變數（kit 升級才不會脫節） */
  .bfk-footer {
    --bfk-fg: var(--white);
    --bfk-muted: var(--gray);
    --bfk-line: var(--gray-dark);
    --bfk-card: var(--bg-card);
    --bfk-accent: var(--yellow);
  }

  /* 貓臉放在品牌名前面。kit 不管這個，各站自己加 */
  .bfk-name::before {
    content: '🐱';
    margin-right: 8px;
    font-size: 20px;
    line-height: 1;
  }
</style>
