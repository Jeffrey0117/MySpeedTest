---
import { brand, siblingTools } from '../data/brand';

const currentYear = new Date().getFullYear();
const copyrightYears =
  currentYear > brand.foundedYear ? `${brand.foundedYear}–${currentYear}` : `${brand.foundedYear}`;
---

<footer class="site-footer">
  <nav class="footer-nav" aria-label="網站導覽">
    <a href="/">測速</a>
    <a href="/learn">測速原理</a>
    <a href="/sdk">開發者 SDK</a>
    <a href="/api">API</a>
    <a href="/blog">部落格</a>
  </nav>

  <section class="brand-block" aria-labelledby="brand-heading">
    <div class="brand-head">
      <a
        class="brand-name"
        id="brand-heading"
        href={brand.home}
        target="_blank"
        rel="noopener"
      >
        <span class="brand-mark" aria-hidden="true">🐱</span>
        {brand.name}
      </a>
      <p class="brand-tagline">{brand.tagline}，MST 測速是其中一個。</p>
    </div>

    <ul class="tool-list">
      {siblingTools.map((tool) => (
        <li>
          <a href={tool.url} target="_blank" rel="noopener">
            <span class="tool-name">{tool.name}</span>
            <span class="tool-blurb">{tool.blurb}</span>
          </a>
        </li>
      ))}
      <li class="tool-more">
        <a href={brand.home} target="_blank" rel="noopener">
          <span class="tool-name">看全部作品</span>
          <span class="tool-blurb">桌面 App、自架服務與開發工具</span>
        </a>
      </li>
    </ul>
  </section>

  <div class="footer-bottom">
    <span>&copy; {copyrightYears} {brand.shortName}</span>
    <a href={brand.github} target="_blank" rel="noopener">GitHub</a>
    <a href={brand.home} target="_blank" rel="noopener">作品站</a>
  </div>
</footer>

<style>
  /* global.css 的 `footer a { margin: 0 15px }` 會波及這裡，整塊自己收回來 */
  .site-footer {
    margin-top: 80px;
    padding: 50px 24px 40px;
    border-top: 1px solid var(--gray-dark);
    text-align: center;
  }

  .site-footer a {
    margin: 0;
    text-decoration: none;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 28px;
    font-size: 14px;
  }

  .footer-nav a {
    color: var(--gray);
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: var(--white);
  }

  /* ===== 品牌區 ===== */
  .brand-block {
    max-width: 760px;
    margin: 44px auto 0;
    padding-top: 36px;
    border-top: 1px solid var(--gray-dark);
  }

  .brand-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    font-weight: 700;
    color: var(--white);
    transition: color 0.2s;
  }

  .brand-name:hover {
    color: var(--yellow);
  }

  .brand-mark {
    font-size: 20px;
    line-height: 1;
  }

  .brand-tagline {
    margin-top: 8px;
    font-size: 13px;
    color: var(--gray);
  }

  .tool-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 10px;
    margin-top: 28px;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .tool-list a {
    display: block;
    padding: 12px 16px;
    border: 1px solid var(--gray-dark);
    border-radius: 10px;
    background: var(--bg-card);
    transition: border-color 0.2s, transform 0.2s;
  }

  .tool-list a:hover {
    border-color: var(--yellow);
    transform: translateY(-2px);
  }

  .tool-name {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--white);
  }

  .tool-blurb {
    display: block;
    margin-top: 3px;
    font-size: 12px;
    color: var(--gray);
  }

  /* 第 7 格，別讓它孤零零卡在最後一行的左邊 */
  .tool-more {
    grid-column: 1 / -1;
  }

  .tool-more a {
    border-style: dashed;
    text-align: center;
  }

  .tool-more .tool-name::after {
    content: ' →';
    color: var(--yellow);
  }

  /* ===== 底部 ===== */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 20px;
    margin-top: 40px;
    font-size: 13px;
    color: var(--gray);
  }

  .footer-bottom a {
    color: var(--gray);
    transition: color 0.2s;
  }

  .footer-bottom a:hover {
    color: var(--white);
  }

  @media (max-width: 768px) {
    .site-footer {
      margin-top: 60px;
      padding: 36px 16px 32px;
    }

    .tool-list {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .tool-list a {
      padding: 10px 12px;
    }
  }

  @media (max-width: 420px) {
    .tool-list {
      grid-template-columns: 1fr;
    }
  }
</style>
